{
  "name": "cath-report-backend-node",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "心カテーテルレポート REST API（Node.js / Express / MongoDB）",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "test": "node --experimental-strip-types --no-warnings --import ./test/register.mjs --test test/*.test.ts",
    "hash-password": "node ../tools/auth/hash_password.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "mongodb": "^6.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
